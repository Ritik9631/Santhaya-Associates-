# ==============================================================================
# Santhaya Associates — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env.local and fill in the values for local development.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Supabase Public API Configuration (Exposed to Browser & Server)
# Obtain from: Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Only Secret (NEVER expose to client/browser)
# Required for administrative operations and server-side RPC execution
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Internal Operations & Alerts (Server-Only)
# Address for operational inquiry alerts to Santhaya estimation team
INTERNAL_NOTIFICATION_EMAIL=inquiries@santhaya.local

# Cryptographic Salt for IP Pseudonymization (Server-Only)
# Generate a random 32+ character string (e.g. `openssl rand -hex 32`)
RATE_LIMIT_SALT=generate-a-secure-random-salt-string-here

# Public Canonical Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Disposable Development Environment Locking & Test Safety
# Required to prevent test runners from targeting unapproved or production environments
DEV_SUPABASE_PROJECT_REF=your-dev-project-ref-here
SUPABASE_ENV=development
ALLOW_TEST_ENV=true

# ==============================================================================
# Transactional Email Outbox & Dispatch Configuration (Server-Only)
# ==============================================================================
# Email provider mode: 'mock' for local simulation / test; 'resend' for live delivery
EMAIL_PROVIDER=mock

# Resend API Key (Required only when EMAIL_PROVIDER=resend)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here

# Verified Sender Address for Outgoing Transmissions
EMAIL_FROM_ADDRESS=notifications@santhaya.local

# Automated Cron & Outbox Worker Protection Secrets
# Generate random 32+ character strings for endpoint authorization
CRON_SECRET=generate-a-secure-cron-secret-here
OUTBOX_WORKER_SECRET=generate-a-secure-worker-secret-here

# Free-Tier Quota Ceilings & Delivery Guards
EMAIL_DAILY_LIMIT=80
EMAIL_MONTHLY_LIMIT=2500

