# ==============================================================================
# Santhaya Associates — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env.local and fill in the values for local development.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Supabase Public API Configuration (Exposed to Browser & Server)
# Obtain from: Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Only Secret (NEVER expose to client/browser)
# Required for administrative operations and server-side RPC execution
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Internal Operations & Alerts (Server-Only)
# Address for operational inquiry alerts to Santhaya estimation team
INTERNAL_NOTIFICATION_EMAIL=inquiries@santhaya.local

# Cryptographic Salt for IP Pseudonymization (Server-Only)
# Generate a random 32+ character string (e.g. `openssl rand -hex 32`)
RATE_LIMIT_SALT=generate-a-secure-random-salt-string-here

# Public Canonical Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
